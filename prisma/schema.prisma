// prisma/schema.prisma
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  ADMIN
  USER
}

model User {
  aiProviderConfig      AIProviderConfig?
  semanticMetrics       SemanticMetric[]
  aiExecutions          AIExecution[]
  investigations        Investigation[]
  databaseConnections   DatabaseConnection[]
  alerts                Alert[]
  scheduledReports      ScheduledReport[]
  id                    String                 @id @default(cuid())
  name                  String?
  email                 String?                @unique
  emailVerified         DateTime?
  password              String?
  role                  UserRole               @default(USER)
  image                 String?
  accounts              Account[]
  isTwoFactorEnabled    Boolean                @default(false)
  twoFactorConfirmation TwoFactorConfirmation?
  dashboards            Dashboard[]
  defaultDashboardId    String?
}

model Dashboard {
  id        String  @id @default(cuid())
  name      String
  boards    Board[]
  userId    String
  isDefault Boolean @default(false)
  // null = private; a non-null token enables a read-only public share link
  shareId   String? @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Board {
  id            String  @id @default(cuid())
  dashboardId   String
  name          String
  currentDataId String?
  width         Int
  height        Int
  // grid layout in column units (react-grid-layout)
  x             Int     @default(0)
  y             Int     @default(0)
  w             Int     @default(4)
  h             Int     @default(8)

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
}

model sampleData {
  id   String @id @default(cuid())
  name String
  data Json
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model VerificationToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model PaswordResetToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorToken {
  id      String   @id @default(cuid())
  email   String
  token   String   @unique
  expires DateTime

  @@unique([email, token])
}

model TwoFactorConfirmation {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId])
}

// AI Native Analytics Feature Models

enum PrivacyMode {
  FULL
  MINIMIZED
  METADATA_ONLY
}

model AIProviderConfig {
  id           String      @id @default(cuid())
  userId       String      @unique
  provider     String      @default("mock") // e.g., "openai", "anthropic", "mock"
  model        String?
  encryptedKey String? // Server-side encrypted key for BYOK
  privacyMode  PrivacyMode @default(MINIMIZED)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SemanticMetric {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  formula     String // e.g., SUM(orders.amount)
  sourceTable String?
  dimensions  String? // JSON string or comma-separated
  timeColumn  String?
  dataType    String? // e.g., "currency", "percentage", "number"
  synonyms    String? // comma-separated
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AIExecution {
  id         String    @id @default(cuid())
  userId     String
  provider   String
  model      String
  startTime  DateTime  @default(now())
  endTime    DateTime?
  durationMs Int?
  tokensUsed Int?
  status     String // "SUCCESS", "ERROR", "RUNNING"
  error      String?
  toolCalls  Int       @default(0)
  prompt     String? // Stored if privacy allows
  result     String? // Stored if privacy allows

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Investigation {
  id        String   @id @default(cuid())
  userId    String
  question  String
  status    String // "IN_PROGRESS", "COMPLETED", "FAILED"
  result    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  steps InvestigationStep[]
  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model InvestigationStep {
  id              String   @id @default(cuid())
  investigationId String
  stepNumber      Int
  action          String // e.g., "Query execution", "Analyze", "Format"
  description     String?
  query           String?
  resultSummary   String?
  durationMs      Int?
  createdAt       DateTime @default(now())

  investigation Investigation @relation(fields: [investigationId], references: [id], onDelete: Cascade)

  @@index([investigationId])
}

model DatabaseConnection {
  id           String   @id @default(cuid())
  userId       String
  name         String
  encryptedUrl String // Server-side encrypted connection string
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Alert {
  id          String    @id @default(cuid())
  userId      String
  name        String
  metricId    String?
  condition   String // e.g., "> 10%"
  threshold   Float
  status      String    @default("ACTIVE") // "ACTIVE", "PAUSED"
  lastChecked DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ScheduledReport {
  id          String    @id @default(cuid())
  userId      String
  name        String
  frequency   String // e.g., "DAILY", "WEEKLY", "MONTHLY"
  dashboardId String?
  lastRun     DateTime?
  nextRun     DateTime?
  status      String    @default("ACTIVE") // "ACTIVE", "PAUSED"
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
